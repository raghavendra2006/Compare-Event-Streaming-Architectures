# =============================================================================
# Event Streaming Architectures - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All variables below are REQUIRED for the application to function.

# --- Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- RabbitMQ Configuration ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# --- Application Configuration ---
ORDER_TOPIC_NAME=orders
ORDER_EXCHANGE_NAME=order-exchange
LOG_LEVEL=INFO

# --- Benchmarking Configuration ---
BENCHMARK_MESSAGE_COUNT=5000
BENCHMARK_BATCH_SIZE=100
